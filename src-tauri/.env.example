# Copy to `src-tauri/.env` for local builds (never commit `.env`).

# --- PocketBase error / crash reports (optional) ---
# Without these, error reporting is a no-op even if the user consents.
IDEI_ERROR_REPORT_URL=https://your-pocketbase.example/api/collections/ideiControl/records
IDEI_ERROR_REPORT_TOKEN=

# --- Tauri updater signing (release / CI only) ---
# Local `npm run tauri build` keeps createUpdaterArtifacts=false — no private key needed.
# GitHub Actions enables updater artifacts and injects:
#   TAURI_SIGNING_PRIVATE_KEY
#   TAURI_SIGNING_PRIVATE_KEY_PASSWORD   (optional)
# Put the matching public key in tauri.conf.json → plugins.updater.pubkey
