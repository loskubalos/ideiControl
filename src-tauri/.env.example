# Copy to `src-tauri/.env` for local builds (never commit `.env`).
# Telemetry is optional — leave unset to disable Umami events.

# Umami base URL, without /api/send
IDEI_TELEMETRY_BASE_URL=https://your-umami.example.com

# Website ID from your Umami dashboard
IDEI_TELEMETRY_WEBSITE_ID=00000000-0000-0000-0000-000000000000

# Hostname label sent with events
IDEI_TELEMETRY_HOSTNAME=idei-control.local
