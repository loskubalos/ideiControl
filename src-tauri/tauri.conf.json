{
  "productName": "IDEI Control",
  "version": "0.1.0",
  "identifier": "com.idei.control",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "IDEI Control",
        "width": 1330,
        "height": 710,
        "resizable": true,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false,
        "transparent": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis", "msi", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/99-ideimx.rules": "extra/99-ideimx.rules"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxMjExRUFBNzFGQTc1RTkKUldUcGRmcHhxaDRoMGY5eDVNN3F1Y1I4WmcvSVF0bytjODRuRzd1WHc5S3NTbUZmSTl3emNtYWMK",
      "endpoints": [
        "https://github.com/loskubalos/ideiControl/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  }
}
